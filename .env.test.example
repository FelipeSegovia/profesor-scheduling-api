# Copiar a .env.test. Usada solo por `pnpm test:e2e` (NODE_ENV=test carga este
# archivo en vez de .env, ver src/config/config.module.ts). Apunta a una base
# separada de la de desarrollo: los e2e truncan tablas entre casos y no deben
# tocar los datos con los que estás probando la app a mano.

DATABASE_URL="postgresql://profesor_scheduling:profesor_scheduling@localhost:5433/agendamientos_test"

NODE_ENV=test
PORT=3000

JWT_SECRET=clave-de-prueba-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d
EDUCATOR_JWT_SECRET=otra-clave-de-prueba-de-al-menos-32-caracteres
EDUCATOR_JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

PUBLIC_WEB_URL=http://localhost:5173

SEED_EDUCATOR_EMAIL=educadora@example.com
SEED_EDUCATOR_PASSWORD=clave-de-prueba

# Sin RESEND_API_KEY a propósito: los e2e nunca envían correos reales (spec 006).

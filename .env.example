# Copiar a .env y ajustar. .env está en .gitignore: nunca commitear credenciales reales.

# --- Base de datos ---
# Debe apuntar al Postgres de docker-compose.yml (puerto 5433 en el host) o a uno propio.
DATABASE_URL="postgresql://profesor_scheduling:profesor_scheduling@localhost:5433/profesor_scheduling"

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- Autenticación (JWT) ---
# Mínimo 32 caracteres. Generar uno nuevo por entorno, nunca reutilizar este valor.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# JWT de la educadora (panel privado). Secreto distinto del anterior a propósito:
# un token de una superficie nunca debe servir en la otra.
EDUCATOR_JWT_SECRET=cambia-esto-tambien-por-otro-secreto-de-32-caracteres
EDUCATOR_JWT_EXPIRES_IN=7d

# --- CORS ---
# Orígenes de los dos frontends de Vite, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://localhost:5173

# --- Enlaces en los correos ---
# Base de las URLs que arma el backend para los enlaces Confirmo / No puedo.
PUBLIC_WEB_URL=http://localhost:5173

# --- Semilla (prisma/seed.ts) ---
# Credenciales de la educadora que crea `pnpm prisma db seed`. Solo las lee el seed.
SEED_EDUCATOR_EMAIL=educadora@example.com
SEED_EDUCATOR_PASSWORD=cambia-esta-clave

# --- Correo (Resend, spec 006) ---
# Descomentar al configurar Resend. Sin RESEND_API_KEY los correos se escriben en
# el log (transporte de consola); en producción es obligatoria.
# API key de https://resend.com/api-keys (empieza con "re_").
# RESEND_API_KEY=
# Remitente. Con dominio verificado: "Loreto Castillo <agenda@tu-dominio.cl>".
# Sin dominio verificado (sandbox), solo sirve onboarding@resend.dev.
# EMAIL_FROM=onboarding@resend.dev
# Dirección a la que llegan las respuestas del apoderado (normalmente la educadora).
# EMAIL_REPLY_TO=
# En modo sandbox, desvía todos los destinatarios a esta dirección y antepone el
# destinatario real al asunto, para poder probar sin un dominio verificado.
# Dejar vacía en producción.
# EMAIL_REDIRECT_TO=
# Cada cuántos milisegundos el despachador revisa el outbox (mínimo 1000).
# OUTBOX_POLL_INTERVAL_MS=15000

# --- Observabilidad (NestJS Observe) ---
# Opcionales. Sin ellas, ObserveModule no se monta.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=

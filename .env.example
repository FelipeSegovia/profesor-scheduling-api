# Copiar a .env y ajustar. .env está en .gitignore: nunca commitear credenciales reales.

# --- Base de datos ---
# Debe apuntar al Postgres de docker-compose.yml (puerto 5433 en el host) o a uno propio.
DATABASE_URL="postgresql://profesor_scheduling:profesor_scheduling@localhost:5433/profesor_scheduling"

# --- Entorno ---
NODE_ENV=development
PORT=3000

# --- Autenticación (JWT) ---
# Mínimo 32 caracteres. Generar uno nuevo por entorno, nunca reutilizar este valor.
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# --- CORS ---
# Orígenes de los dos frontends de Vite, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Enlaces en los correos ---
# Base de las URLs que arma el backend para los enlaces Confirmo / No puedo.
PUBLIC_WEB_URL=http://localhost:5173

# --- Semilla (prisma/seed.ts) ---
# Credenciales de la educadora que crea `pnpm prisma db seed`. Solo las lee el seed.
SEED_EDUCATOR_EMAIL=educadora@example.com
SEED_EDUCATOR_PASSWORD=cambia-esta-clave

# --- Correo (Resend) ---
# Opcionales en esta spec (001); pasan a requeridas en la spec 002, cuando exista
# el adaptador que realmente envía correos.
# RESEND_API_KEY=
# EMAIL_FROM=onboarding@resend.dev
# En modo sandbox, desvía todos los destinatarios a esta dirección y antepone el
# destinatario real al asunto, para poder probar sin un dominio verificado.
# EMAIL_REDIRECT_TO=

# --- Observabilidad (NestJS Observe) ---
# Opcionales. Sin ellas, ObserveModule no se monta.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
